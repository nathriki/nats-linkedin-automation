# LinkedIn OAuth (from the LinkedIn developer app)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback
LINKEDIN_SCOPES=openid,profile,w_member_social,email

# Gemini (drafter, and later the risk-classifier) -- free tier
GEMINI_API_KEY=

# Telegram approval bot -- create a bot via @BotFather (/newbot), then run
# approval_bot/get_chat_id.py after messaging the bot once to fill in CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Unsplash (post images) -- free "Demo" app, 50 req/hr, no card needed.
# Create one at https://unsplash.com/oauth/applications, then copy its
# "Access Key" here.
UNSPLASH_ACCESS_KEY=
